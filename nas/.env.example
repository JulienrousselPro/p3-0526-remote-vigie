# Copier en ".env" (dans ce dossier, sur le NAS), puis : chmod 600 .env
# Ne JAMAIS committer le .env. Guide : DEPLOIEMENT.md

# Adresse publique donnée par Tailscale, sans slash final (figée dans le front au build).
# Exemple : https://vigie.tail1a2b3c.ts.net
PUBLIC_URL=
WEB_PORT=3310

# Générer :  openssl rand -hex 32
APP_SECRET=

# Base de données (générer chaque mot de passe : openssl rand -hex 24)
DB_NAME=vigie
DB_USER=vigie
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Tailscale : clé d'authentification (tskey-auth-…), étiquetée tag:vigie.
# Ne sert qu'au premier démarrage ; peut être vidée ensuite.
TS_AUTHKEY=

# Gmail : adresse + mot de passe d'application (16 caractères, sans espaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Google OAuth (US22) — mêmes valeurs que dans server/.env.
# Ajouter ${PUBLIC_URL}/api/auth/google/callback dans la console Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (US21) — générer UNE fois :
#   docker run --rm node:20-alpine npx -y web-push generate-vapid-keys
# Ne jamais régénérer ensuite (cela couperait tous les abonnements).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-adresse@gmail.com

# Météo-France (bandeau vigilance, US11) — même clé que dans server/.env
METEO_API_KEY=
